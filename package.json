{
  "name": "cif-to-json",
  "version": "2.0.0",
  "description": "Parsing CIF (Crystallographic Information File)",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "npm run tsc && cheminfo-build --entry lib/index.js --root CIF",
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheminfo/cif-to-json.git"
  },
  "keywords": [
    "chemistry",
    "CIF",
    "crystallography",
    "parser"
  ],
  "author": "Luc Patiny <luc@patiny.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/cif-to-json/issues"
  },
  "homepage": "https://github.com/cheminfo/cif-to-json#readme",
  "peerDependencies": {
    "openchemlib": ">=8"
  },
  "peerDependenciesMeta": {
    "openchemlib": {
      "optional": true
    }
  },
  "dependencies": {
    "cheminfo-types": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@zakodium/tsconfig": "^1.0.5",
    "cheminfo-build": "^1.4.0",
    "eslint": "^10.15.0",
    "eslint-config-cheminfo-typescript": "^23.0.0",
    "fifo-logger": "^2.0.1",
    "openchemlib": "^9.26.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "info": {
    "logo": "https://raw.githubusercontent.com/cheminfo/font/master/src/misc/cristal.svg",
    "domain": [
      "Physical Chemistry",
      "Materials Science"
    ],
    "functionality": {
      "fileTypes": [
        {
          "extension": "cif",
          "manufacturer": "IUCr",
          "example": "https://raw.githubusercontent.com/cheminfo/cif-to-json/main/src/__tests__/test.cif"
        }
      ]
    }
  }
}
